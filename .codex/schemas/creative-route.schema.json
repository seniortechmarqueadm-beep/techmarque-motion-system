{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Motion Director Creative Route",
  "type": "object",
  "required": ["route_id", "thesis", "mechanism", "translation", "scores"],
  "properties": {
    "route_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "operator": {"type": "string", "enum": ["INVERT", "TRANSFER", "CONSTRAIN", "REMOVE", "AMPLIFY", "COLLIDE", "SEQUENCE", "MATERIALIZE", "REVERSE"]},
    "thesis": {"type": "string", "minLength": 10},
    "mechanism": {"type": "string", "minLength": 10},
    "translation": {"type": "string", "minLength": 10},
    "signature": {"type": "string"},
    "mvp": {"type": "string"},
    "premium": {"type": "string"},
    "fallback": {"type": "string"},
    "editability": {"type": "string"},
    "repeatability": {"type": "string"},
    "risks": {"type": "array", "items": {"type": "string"}},
    "scores": {"type": "object", "required": ["brand", "novelty", "clarity", "feasibility", "editability", "risk"], "properties": {"brand": {"type": "number", "minimum": 0, "maximum": 5}, "novelty": {"type": "number", "minimum": 0, "maximum": 5}, "clarity": {"type": "number", "minimum": 0, "maximum": 5}, "feasibility": {"type": "number", "minimum": 0, "maximum": 5}, "editability": {"type": "number", "minimum": 0, "maximum": 5}, "risk": {"type": "number", "minimum": 0, "maximum": 5}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
