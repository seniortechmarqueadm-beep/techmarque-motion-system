{
  "name": "techmarque-motion-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Espelho tecnico versionado do sistema local de motion design, Remotion e producao audiovisual da Techmarque.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "remotion bundle src/index.ts out/bundle",
    "render:demo": "remotion render src/index.ts TechmarqueMotionDemo out/techmarque-motion-demo.mp4",
    "render:opportunity": "remotion render src/index.ts TechmarqueOpportunityPath out/techmarque-opportunity-path.mp4",
    "still:opportunity": "remotion still src/index.ts TechmarqueOpportunityPath out/techmarque-opportunity-path-frame.png --frame=900"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.485",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.485"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
